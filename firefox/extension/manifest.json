{
  "manifest_version": 2,
  "name": "Idlerx",
  "version": "1.0.0",
  "description": "Connects the Idlerx app to its Firefox: one container and one window per account.",
  "browser_specific_settings": {
    "gecko": {
      "id": "idlerx@antxj.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "contextualIdentities",
    "cookies",
    "tabs",
    "webNavigation",
    "browserSettings",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
